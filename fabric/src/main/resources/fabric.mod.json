{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${fabric_mod_authors}"
    ],
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
      "main": [
        "net.camacraft.stereospace.fabric.StereoSpaceFabric"
      ],
      "client": [
        "net.camacraft.stereospace.fabric.StereoSpaceFabricClient"
      ]
    },
    "mixins": [
      "stereospace.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
